{
  "info": {
    "name": "Beershop API - Postman Collection",
    "description": "Collection for testing Beershop Modular REST API v1 with JWT Auth, Role Permissions, and Security Headers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "adminToken", "value": "" },
    { "key": "customerTokenA", "value": "" },
    { "key": "customerTokenB", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aa@gmail.com\",\n  \"password\": \"0000\"\n}"
            }
          }
        },
        {
          "name": "Login as Customer A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('customerTokenA', jsonData.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cc@gmail.com\",\n  \"password\": \"0000\"\n}"
            }
          }
        },
        {
          "name": "Get Profile (/auth/me)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerTokenA}}" },
              { "key": "Accept", "value": "application/json" }
            ]
          }
        }
      ]
    },
    {
      "name": "2. Products",
      "item": [
        {
          "name": "List Products (Paginated)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products?page=1&per_page=5",
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Filter Products by Category",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products?category_id=1",
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Get Product Details",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/1",
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        }
      ]
    },
    {
      "name": "3. Orders & Security Verification",
      "item": [
        {
          "name": "Create Order (Customer A)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/orders",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerTokenA}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Customer A\",\n  \"email\": \"cc@gmail.com\",\n  \"address\": \"Damascus, Street 1\",\n  \"phone\": \"0999999999\",\n  \"note\": \"Fragile items\",\n  \"items\": [\n    {\n      \"product_id\": 1,\n      \"quantity\": 2\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Customer A Views Own Orders",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerTokenA}}" },
              { "key": "Accept", "value": "application/json" }
            ]
          }
        },
        {
          "name": "Security Test - Customer tries to change status (Expect 403 Forbidden)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/orders/1/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerTokenA}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            }
          }
        },
        {
          "name": "Admin Changes Order Status (Expect 200 OK)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/orders/1/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. Notifications",
      "item": [
        {
          "name": "List User Notifications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/notifications",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerTokenA}}" },
              { "key": "Accept", "value": "application/json" }
            ]
          }
        }
      ]
    }
  ]
}
